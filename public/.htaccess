# Hostinger (Apache / LiteSpeed) — coloque este arquivo na raiz de public_html.
#
# Os dois headers abaixo liberam SharedArrayBuffer. São opcionais: sem eles o
# sistema inteiro funciona, incluindo o DOOM (js-dos em modo worker, testado).
# O ganho é desempenho — o Chess, por exemplo, troca o Stockfish de uma thread
# pelo multithread quando o navegador está isolado.
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "credentialless"
</IfModule>

# Alguns servidores entregam .wasm como octet-stream, o que impede a compilação
# em streaming e faz o módulo falhar ao carregar.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/wasm
</IfModule>

# Os assets do Next levam hash no nome, então podem ser cacheados para sempre.
# O HTML não: precisa revalidar para o deploy novo aparecer.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|png|jpg|svg|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
